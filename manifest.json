{
  "manifest_version": 3,
  "name": "Ahrefs SEO Data Extractor",
  "version": "1.0.0",
  "description": "Extract structured SEO data from Ahrefs dashboard pages",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://app.ahrefs.com/*", "https://ahrefs.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.ahrefs.com/*", "https://ahrefs.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  }
}
